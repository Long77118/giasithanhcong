{
  "name": "bao-bi-an-phat-b2b",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack -p 3000 -H 0.0.0.0",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation next build --webpack",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation next start -p 3000 -H 0.0.0.0",
    "clean": "rm -rf .next dist",
    "lint": "tsc --noEmit",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "db:migrate:create": "cross-env PAYLOAD_MIGRATING=true NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:migrate": "cross-env PAYLOAD_MIGRATING=true NODE_OPTIONS=--no-deprecation payload migrate",
    "db:seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/run.ts",
    "cf:build": "cross-env DEPLOY_TARGET=cloudflare CLOUDFLARE_BUILD=true ALLOW_INDEXING=false opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:check": "node scripts/check-cloudflare-config.mjs",
    "cf:deploy": "npm run cf:check && cross-env CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://deploy_only:deploy_only@127.0.0.1:5432/deploy_only opennextjs-cloudflare deploy",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-r2": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@tailwindcss/postcss": "^4.3.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "graphql": "^16.9.0",
    "lucide-react": "^0.546.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "pg": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "jsonc-parser": "3.3.1",
    "@types/node": "^22.14.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "wrangler": "4.165.0"
  },
  "trustedDependencies": ["esbuild", "sharp", "workerd"],
  "overrides": {
    "@aws-sdk/lib-storage": "3.984.0",
    "@aws-sdk/s3-request-presigner": "3.984.0",
    "dompurify": "3.4.18",
    "happy-dom": "21.0.4",
    "esbuild": "0.28.2"
  }
}
