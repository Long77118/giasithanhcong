# Application URL (used for canonical URLs, Open Graph, sitemap.xml, robots.txt)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SEO Indexing Guard: set to "true" ONLY on production domain; keep "false" on staging/dev
ALLOW_INDEXING="false"

# Payload CMS Secret (generate a strong 32+ char random string, never commit real secrets)
PAYLOAD_SECRET="replace-with-a-32-char-random-secret-key"

# PostgreSQL / Cloud SQL Connection Variables (Object Method - no DATABASE_URL)
# App runtime user (read/write data only)
SQL_HOST="/app/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE"
SQL_DB_NAME="your_database_name"
SQL_USER="your_app_user"
SQL_PASSWORD="replace-with-app-user-password"

# Admin user (required only for running schema migrations)
SQL_ADMIN_USER="your_admin_user"
SQL_ADMIN_PASSWORD="replace-with-admin-password"
